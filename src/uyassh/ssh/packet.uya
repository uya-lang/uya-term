// src/uyassh/ssh/packet.uya - SSH 二进制包协议与加密套件（RFC 4253 §6 / §7.2）
//
// 说明：SSH 的每个包是
//       u32 packet_length | byte padding_length | payload | padding | MAC
//     packet_length 不含自身与 MAC；未加密时要求 (packet_length + 4) 是 8 的整数倍，
//     加密后是块大小（AES 为 16）的整数倍。
//
// 本层负责：组包（含随机 padding）、按序号算 MAC、AES-CTR 加解密与序号维护。
//
// 踩坑记录（都写在这里，别再踩第二次）：
//   * **MAC 与加密的先后顺序**：先算 MAC（覆盖 seq || 明文包），再对整包加密；
//     顺序写反不会编译报错，只会让对端在第一个包就判 MAC 错。
//     本实现只做这条普通路径：-etm 的载荷边界（packet_length 是否在密文内）无法
//     离线核对规范，宁可显式不实现，也不要塞一个「看起来能用」的错误格式——
//     非 etm 的 hmac-sha2-256 与 OpenSSH 正常协商。
//   * **AES-CTR 是连续流，不能每包重置计数器**：IV 只在 NEWKEYS 时按 §7.2 设定一次，
//     之后随数据流递进；每包重置会让第二个包起就对不上（首个包永远是对的，极易误判）。
//   * **序号每包自增，方向独立**：发送与接收各自计数，NEWKEYS 后都归零。
//   * SHA-256 的 MAC 用流式版本（包可达 64 KiB，std 的一次性 HMAC 有 256 字节上限）。

use std.crypto.sha256;
use std.crypto.sha256.HmacSha256Ctx;
use tls.crypto.aes;
use util.buf.Buf;
use util.buf.buf_new;
use util.buf.buf_free;
use util.buf.buf_reserve;
use util.buf.buf_append;
use util.buf.buf_append_byte;
use util.rand.fill_random;
use ssh.wire.wire_put_u32;
use ssh.wire.wire_get_u32;
use ssh.wire.wire_append_u32;

/// 明文包上限（RFC 4253 要求至少支持 35000；这里给到 64 KiB）。
export const PACKET_MAX: usize = 65536;

/// HMAC-SHA256 输出长度。
export const MAC_LEN: usize = 32;

/// 块大小（AES 为 16）。
export const BLOCK_LEN: usize = 16;

/// 未加密时的块大小（协议下限 8）。
export const MIN_BLOCK: usize = 8;

/// 加密套件方向状态。
/// 字段：key 为 AES 密钥，ctr 为 CTR 计数器块（流式递进），mac_key 为 MAC 密钥，
///       seq 为下一个包的序号，active 表示是否启用，
///       ks/ks_used 为 keystream 缓冲（保证 CTR 跨包连续）。
export struct CipherState {
    key: [byte: 32],
    key_len: usize,
    ctr: [byte: 16],
    mac_key: [byte: 64],
    mac_key_len: usize,
    seq: u32,
    active: bool,
    ks: [byte: 16],
    ks_used: usize,
}

/// 新建未启用的加密状态。
/// 参数：无。
/// 返回值：状态实例。
export fn cipher_state_new() CipherState {
    return CipherState{
        key: [0: 32],
        key_len: 0,
        ctr: [0: 16],
        mac_key: [0: 64],
        mac_key_len: 0,
        seq: 0,
        active: false,
        ks: [0: 16],
        ks_used: 16,
    };
}

/// 设定密钥与 IV 并启用。
/// 参数：st 为状态，key/key_len 为 AES 密钥，iv 为 16 字节计数器初始值，
///       mac_key/mac_key_len 为 MAC 密钥。
/// 返回值：无。
export fn cipher_state_setup(st: &CipherState, key: &const byte, key_len: usize, iv: &const byte,
    mac_key: &const byte, mac_key_len: usize) void {
    var i: usize = 0;
    while i < key_len && i < 32 {
        st.key[i] = key[i];
        i = i + 1;
    }
    st.key_len = key_len;
    i = 0;
    while i < 16 {
        st.ctr[i] = iv[i];
        i = i + 1;
    }
    i = 0;
    while i < mac_key_len && i < 64 {
        st.mac_key[i] = mac_key[i];
        i = i + 1;
    }
    st.mac_key_len = mac_key_len;
    st.seq = 0;
    st.active = true;
    st.ks_used = 16;
}

/// 复位序号（NEWKEYS 后调用）。
/// 参数：st 为状态。
/// 返回值：无。
export fn cipher_state_reset_seq(st: &CipherState) void {
    st.seq = 0;
}

/// 计数器自增（大端 128 位）。
/// 参数：ctr 为 16 字节计数器。
/// 返回值：无。
fn packet_ctr_increment(ctr: &byte) void {
    var i: i32 = 15;
    while i >= 0 {
        const nv: byte = ctr[i as usize] + (1 as byte);
        ctr[i as usize] = nv;
        if nv != 0 {
            return;
        }
        i = i - 1;
    }
}

/// 生成新的 keystream 块（加密计数器块后自增）。
/// 参数：st 为状态。
/// 返回值：无。
fn packet_ks_refill(st: &CipherState) void {
    aes.aes_encrypt_block(&st.key[0], st.key_len, &st.ctr[0], &st.ks[0]);
    packet_ctr_increment(&st.ctr[0]);
    st.ks_used = 0;
}

/// AES-CTR 就地异或（加解密对称）；流式连续，不重置计数器。
/// 参数：st 为状态，data/n 为待处理数据。
/// 返回值：无。
export fn packet_ctr_xor(st: &CipherState, data: &byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        if st.ks_used >= 16 {
            packet_ks_refill(st);
        }
        if st.ks_used < 16 {
            data[i] = data[i] ^ st.ks[st.ks_used];
        }
        st.ks_used = st.ks_used + 1;
        i = i + 1;
    }
}

/// 计算 MAC：HMAC-SHA256(mac_key, seq || data)。
/// 参数：st 为状态，seq 为序号，data/n 为被覆盖数据，out 为 32 字节输出。
/// 返回值：无。
export fn packet_mac(st: &CipherState, seq: u32, data: &const byte, n: usize, out: &byte) void {
    var seqbuf: [byte: 4] = [0: 4];
    wire_put_u32(&seqbuf[0], seq);
    var ctx: HmacSha256Ctx = HmacSha256Ctx{};
    ctx.init(&st.mac_key[0], st.mac_key_len);
    ctx.update(seqbuf[0: 4]);
    ctx.update(data[0: n]);
    var mac: [byte: 32] = [0: 32];
    ctx.final(mac[0: 32]);
    var i: usize = 0;
    while i < 32 {
        out[i] = mac[i];
        i = i + 1;
    }
}

/// 常量时间比较两段字节。
/// 参数：a/b 为待比较数据，n 为长度。
/// 返回值：相等返回 true。
export fn packet_mac_eq(a: &const byte, b: &const byte, n: usize) bool {
    var diff: byte = 0;
    var i: usize = 0;
    while i < n {
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    }
    return diff == 0;
}

/// 组一个待发送的包（含 padding 与 MAC，按需加密），把结果写到 out。
/// 参数：st 为发送方向状态，payload/n 为明文载荷，out 为输出缓冲（会被重置并填充）。
/// 返回值：成功返回 true。
export fn packet_build(st: &CipherState, payload: &const byte, n: usize, out: &Buf) bool {
    if n > PACKET_MAX {
        return false;
    }
    const block: usize = if st.active { BLOCK_LEN } else { MIN_BLOCK };
    // 明文部分 = padding_length(1) + payload + padding
    // packet_length + 4 必须是 block 的倍数
    var pad: usize = block - ((n + 1 + 4) % block);
    if pad < 4 {
        pad = pad + block;
    }
    const packet_len: usize = 1 + n + pad;
    const total: usize = 4 + packet_len;
    const need: usize = total + (if st.active { MAC_LEN } else { 0 });
    const reserved: !void = buf_reserve(out, need + 16);
    _ = reserved catch { return false; };
    out.len = 0;
    var hdr: [byte: 4] = [0: 4];
    wire_put_u32(&hdr[0], packet_len as u32);
    const a1: !void = buf_append(out, &hdr[0], 4);
    _ = a1 catch { return false; };
    const p1: !void = buf_append_byte(out, pad as byte);
    _ = p1 catch { return false; };
    if n > 0 {
        const a2: !void = buf_append(out, payload, n);
        _ = a2 catch { return false; };
    }
    // 随机 padding
    var padbuf: [byte: 64] = [0: 64];
    var written: usize = 0;
    while written < pad {
        var take: usize = pad - written;
        if take > 64 {
            take = 64;
        }
        const r: !void = fill_random(&padbuf[0], take);
        r catch {
            // 取不到熵也不能编零（会削弱协议）；直接失败
            return false;
        };
        const a3: !void = buf_append(out, &padbuf[0], take);
        _ = a3 catch { return false; };
        written = written + take;
    }
    const seq: u32 = st.seq;
    if st.active {
        // 普通模式（RFC 4253 §6.4）：先算 MAC（覆盖 seq || 明文包，含 packet_length），
        // 再加密**整个包**（包括开头的 packet_length 字段——见 packet_parse 里的说明，
        // 这一点弄错的话只有连真实服务端才会暴露）。
        var mac: [byte: 32] = [0: 32];
        packet_mac(st, seq, out.data, total, &mac[0]);
        packet_ctr_xor(st, out.data, total);
        const a5: !void = buf_append(out, &mac[0], MAC_LEN);
        _ = a5 catch { return false; };
    }
    st.seq = st.seq + 1;
    return true;
}

/// 从已收到的字节流解析一个完整包，返回消费的字节数与载荷位置。
/// 参数：st 为接收方向状态，buf/n 为累计缓冲，used 为已消费字节数（输出），
///       payload_off/payload_len 为载荷在 buf 中的偏移与长度（输出）。
/// 返回值：解析出完整包返回 true；数据不足或非法返回 false（并置 used=0）。
export fn packet_parse(st: &CipherState, buf: &byte, n: usize, used: &usize,
    payload_off: &usize, payload_len: &usize) bool {
    used[0] = 0;
    payload_off[0] = 0;
    payload_len[0] = 0;
    if !st.active {
        if n < 5 {
            return false;
        }
        const packet_len: usize = wire_get_u32(buf) as usize;
        if packet_len < 5 || packet_len > PACKET_MAX + 64 {
            // 非法长度：标记为「已消费 0」由调用方判定协议错
            return false;
        }
        const total: usize = 4 + packet_len;
        if n < total {
            return false;
        }
        const pad: usize = buf[4] as usize;
        if pad + 1 > packet_len {
            return false;
        }
        payload_off[0] = 5;
        payload_len[0] = packet_len - 1 - pad;
        used[0] = total;
        st.seq = st.seq + 1;
        return true;
    }
    // 最小密文包只有 4(长度) + 12(packet_len) = 16 字节 + MAC，
    // 而第一块需 16 字节——所以下界就是 BLOCK_LEN + MAC_LEN，**不能**写成
    // 4 + BLOCK_LEN + MAC_LEN（那会把最小的合法包误判为「数据不足」，
    // 症状是「小包永远解析失败，大包正常」，极难定位）。
    if n < BLOCK_LEN + MAC_LEN {
        return false;
    }
    // **packet_length 也是加密的**（RFC 4253 §6："the packet_length field is also
    // encrypted"）。普通模式（aes*-ctr + hmac-sha2-*）下，密文覆盖从
    // packet_length 开始的**整个包**，只有 MAC 是明文附在末尾。
    //
    // 这里踩过一个代价很大的坑：我原本以为 packet_length 保持明文（那只在
    // AEAD 模式如 chacha20-poly1305 下才成立），于是发送时只加密 packet_length
    // 之后的内容。结果服务端用新密钥解密我们那个包时，把明文的 `00 00 00 1c`
    // 当成密文去解，读出一个天文数字长度，日志里报
    //     Bad packet length 4161568435. → message authentication code incorrect
    // 而自己的单元测试完全测不出来——因为收发双方用的是同一套错误约定，
    // 自洽地互相验证通过了。**只有对真实服务端才会暴露**。
    //
    // 因此解密必须从 buf[0] 开始，解出来的前 4 字节才是真正的 packet_length。
    // 问题：要先知道长度才能知道解密多少字节，而长度本身是加密的。
    // 解决办法（标准做法）：密文长度必为 block 的整数倍，因此先解出**第一个
    // block**（16 字节），从前 4 字节读出 packet_length，再解剩下的部分。
    // CTR 是流式的，按前缀增量解密不会错位。
    var head: [byte: 16] = [0: 16];
    var hi: usize = 0;
    while hi < 16 {
        head[hi] = buf[hi];
        hi = hi + 1;
    }
    packet_ctr_xor(st, &head[0], 16);
    const packet_len: usize = wire_get_u32(&head[0]) as usize;
    if packet_len < 5 || packet_len > PACKET_MAX + 64 {
        return false;
    }
    const total: usize = 4 + packet_len;
    if n < total + MAC_LEN {
        return false;
    }
    // 头 16 字节已经解过，接着解剩余部分（同一 keystream 延续）
    if packet_len > 12 {
        packet_ctr_xor(st, buf + 16, packet_len - 12);
    }
    hi = 0;
    while hi < 16 {
        buf[hi] = head[hi];
        hi = hi + 1;
    }
    // MAC 覆盖 seq || **明文包**（RFC 4253 §6.4）。所以要先把整个包解成明文，
    // 再对明文算 MAC 比对；拿密文算 MAC 会让每个包都判失败。
    var mac: [byte: 32] = [0: 32];
    packet_mac(st, st.seq, buf, total, &mac[0]);
    if !packet_mac_eq(&mac[0], buf + total, MAC_LEN) {
        return false;
    }
    const pad: usize = buf[4] as usize;
    if pad + 1 > packet_len {
        return false;
    }
    payload_off[0] = 5;
    payload_len[0] = packet_len - 1 - pad;
    used[0] = total + MAC_LEN;
    st.seq = st.seq + 1;
    return true;
}

/// 复制密码状态（用于「预览解密」取长度而不推进真实 CTR/seq）。
/// 参数：dst 为目标，src 为源。
/// 返回值：无。
///
/// 说明：RFC 4253 §6 规定 packet_length 本身也是密文，所以读包时必须先解出
/// 第一个 block 才能知道长度。用一个副本试探解密，可以避免在真实状态上
/// 多推一次 keystream。
export fn cipher_state_copy(dst: &CipherState, src: &const CipherState) void {
    var i: usize = 0;
    while i < 32 {
        dst.key[i] = src.key[i];
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        dst.ctr[i] = src.ctr[i];
        i = i + 1;
    }
    i = 0;
    while i < 64 {
        dst.mac_key[i] = src.mac_key[i];
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        dst.ks[i] = src.ks[i];
        i = i + 1;
    }
    dst.key_len = src.key_len;
    dst.mac_key_len = src.mac_key_len;
    dst.seq = src.seq;
    dst.active = src.active;
    dst.ks_used = src.ks_used;
}
