// src/uyassh/net/tcp.uya - TCP 连接、超时读写与就绪等待（纯 Uya，静态链接可用）
//
// 说明：SSH 传输层需要一条可读写的 TCP 流。这里做四件事：
//   1) 地址解析（点分十进制直读，否则走 std.net.dns）
//   2) 建连（socket + 非阻塞 connect + poll 超时 + SO_ERROR 复检）
//   3) 带超时的 read/write 包装
//   4) 关连接
//
// 踩坑记录（都实测过）：
//   * **sockaddr_in 的字段顺序是 family(2) | port(2, 大端) | addr(4)**。把 port 放到
//     family 之后的低字节、或与小端混用，会连到一个「看似成立」的错地址。
//   * **非阻塞 connect 返回 EINPROGRESS(115)** 是正常的，必须等可写并用
//     getsockopt(SO_ERROR) 取真实结果；把 115 当失败会让每次连接都失败。
//   * **不设非阻塞也不能裸阻塞**：阻塞 connect 到不可达地址会卡住整个会话，
//     因此连接阶段一律非阻塞 + poll 超时，连上后再按需切回阻塞做整包读写。

use libc.syscall;
use std.net.dns.DnsClient;
use std.net.dns.dns_client_init;
use std.net.dns.dns_client_resolve_first_ipv4;
use std.net.dns.dns_client_set_timeout_ms;

/// 连接默认超时（毫秒）。
export const TCP_CONNECT_TIMEOUT_MS: i32 = 10000;

/// SO_ERROR 的 optname（Linux 为 4）。
const SO_ERROR_OPT: i32 = 4;

/// 错误：DNS 解析失败。
export error TcpResolveFailed;
/// 错误：socket 创建失败。
export error TcpSocketFailed;
/// 错误：连接失败或超时。
export error TcpConnectFailed;
/// 错误：读写失败。
export error TcpIoFailed;
/// 错误：连接已关闭。
export error TcpClosed;
/// 错误：等待超时。
export error TcpTimeout;

/// 解析主机名为 IPv4（4 字节网络序）。
/// 参数：host 为主机名（C 串），out 为 4 字节输出。
/// 返回值：成功返回 true。
export fn tcp_resolve(host: &const byte, out: &byte) bool {
    var host_len: usize = 0;
    while host[host_len] != 0 {
        host_len = host_len + 1;
    }
    if host_len == 0 {
        return false;
    }
    if tcp_parse_ipv4(host, host_len, out) {
        return true;
    }
    var ctx: DnsClient = DnsClient{
        nameserver: [0: 16],
        nameserver_len: 0,
        nameserver_port: 0,
        timeout_ms: 5000,
        query_id: 0x1234,
        prefer_family: 1,
    };
    dns_client_init(&ctx, &""[0: 0]);
    dns_client_set_timeout_ms(&ctx, 5000);
    var buf: [byte: 16] = [0: 16];
    var n: usize = 0;
    const r: !usize = dns_client_resolve_first_ipv4(&ctx, host, host_len, &buf[0], 16, &n);
    const got: usize = r catch { return false; };
    if got < 4 {
        return false;
    }
    var i: usize = 0;
    while i < 4 {
        out[i] = buf[i];
        i = i + 1;
    }
    return true;
}

/// 解析点分十进制 IPv4。
/// 参数：s/n 为输入文本，out 为 4 字节输出。
/// 返回值：成功返回 true。
export fn tcp_parse_ipv4(s: &const byte, n: usize, out: &byte) bool {
    var part: usize = 0;
    var val: u32 = 0;
    var digits: usize = 0;
    var i: usize = 0;
    while i < n {
        const c: byte = s[i];
        if c >= 48 && c <= 57 {
            val = val * (10u32) + (((c - (48 as byte)) as u32));
            digits = digits + 1;
            if val > 255u32 || digits > 3 {
                return false;
            }
        } else if c == 46 as byte {
            if digits == 0 || part >= 3 {
                return false;
            }
            out[part] = val as byte;
            part = part + 1;
            val = 0;
            digits = 0;
        } else {
            return false;
        }
        i = i + 1;
    }
    if digits == 0 || part != 3 {
        return false;
    }
    out[3] = val as byte;
    return true;
}

/// 等待 fd 上的事件。
/// 参数：fd 为描述符，events 为 poll 事件掩码，timeout_ms 为超时（毫秒，负数无限）。
/// 返回值：就绪返回 true（含对端关闭）。
fn tcp_poll(fd: i32, events: i16, timeout_ms: i32) bool {
    var fds: [PollFd: 1] = [PollFd{ fd: 0, events: 0, revents: 0 }];
    fds[0].fd = fd;
    fds[0].events = events;
    const n: i32 = sys_poll(&fds[0], 1, timeout_ms) catch { -1 as i32; };
    if n <= 0 {
        return false;
    }
    const rev: i32 = fds[0].revents as i32;
    return (rev & (events as i32)) != 0 || (rev & (POLLERR as i32)) != 0 ||
        (rev & (POLLHUP as i32)) != 0;
}

/// 等待 fd 可读。
/// 参数：fd 为描述符，timeout_ms 为超时。
/// 返回值：可读返回 true。
export fn tcp_wait_readable(fd: i32, timeout_ms: i32) bool {
    return tcp_poll(fd, POLLIN, timeout_ms);
}

/// 等待 fd 可写。
/// 参数：fd 为描述符，timeout_ms 为超时。
/// 返回值：可写返回 true。
export fn tcp_wait_writable(fd: i32, timeout_ms: i32) bool {
    return tcp_poll(fd, POLLOUT, timeout_ms);
}

/// 读取 SO_ERROR（连接完成的真实结果）。
/// 参数：fd 为描述符。
/// 返回值：错误码（0 表示成功）。
fn tcp_so_error(fd: i32) i32 {
    var val: [i32: 1] = [0];
    var len: u32 = 4;
    const r: i32 = sys_getsockopt(fd, SOL_SOCKET, SO_ERROR_OPT, &val[0] as *void, &len) catch { -1 as i32; };
    if r != 0 {
        return -1;
    }
    return val[0];
}

/// 把 fd 设为非阻塞。
/// 参数：fd 为描述符。
/// 返回值：成功返回 true。
fn tcp_set_nonblocking(fd: i32) bool {
    const fl: i32 = sys_fcntl(fd, F_GETFL, 0) catch { return false; };
    const r: i32 = sys_fcntl(fd, F_SETFL, fl | (O_NONBLOCK as i32)) catch { return false; };
    return r == 0;
}

/// 把 fd 设为阻塞。
/// 参数：fd 为描述符。
/// 返回值：成功返回 true。
fn tcp_set_blocking(fd: i32) bool {
    const fl: i32 = sys_fcntl(fd, F_GETFL, 0) catch { return false; };
    const r: i32 = sys_fcntl(fd, F_SETFL, fl & (~(O_NONBLOCK as i32))) catch { return false; };
    return r == 0;
}

/// 建立到 host:port 的 TCP 连接。
/// 参数：host 为主机名或点分十进制，port 为端口，timeout_ms 为连接超时。
/// 返回值：成功返回已连接且阻塞的 fd。
export fn tcp_connect(host: &const byte, port: u16, timeout_ms: i32) !i32 {
    var ip: [byte: 4] = [0: 4];
    if !tcp_resolve(host, &ip[0]) {
        return error.TcpResolveFailed;
    }
    return tcp_connect_ip(&ip[0], port, timeout_ms);
}

/// 建立到指定 IPv4 的 TCP 连接（非阻塞 connect + poll + SO_ERROR）。
/// 参数：ip 为 4 字节网络序地址，port 为端口，timeout_ms 为超时。
/// 返回值：成功返回已连接且阻塞的 fd。
export fn tcp_connect_ip(ip: &const byte, port: u16, timeout_ms: i32) !i32 {
    const fd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return error.TcpSocketFailed;
    };
    var ok: bool = false;
    defer {
        if !ok {
            _ = sys_close(fd) catch { 0 as i32; };
        }
    }
    if !tcp_set_nonblocking(fd) {
        return error.TcpSocketFailed;
    }
    // sockaddr_in：family(2) | port(2, 大端) | addr(4)
    var sa: [byte: 16] = [0: 16];
    sa[0] = 2 as byte;
    sa[1] = 0 as byte;
    sa[2] = ((port >> (8 as i32)) & (255 as u16)) as byte;
    sa[3] = (port & (255 as u16)) as byte;
    sa[4] = ip[0];
    sa[5] = ip[1];
    sa[6] = ip[2];
    sa[7] = ip[3];
    // 注意：**不要在 catch 块里写 return**。Uya 的 `x catch { return v; }` 里那个 return
    // 会直接从**外层函数**返回，而不是仅仅给表达式一个值——于是「连接进行中」被当成
    // 「函数返回 0」。这里改用「先取值、再判错」：
    var rc: i32 = 0;
    var conn_err: i32 = 0;
    const cr: !i32 = sys_connect(fd, &sa[0] as *void, 16 as u32);
    rc = cr catch |err| {
        conn_err = (@error_id(err) as! i32).value;
        -1 as i32;
    };
    if rc != 0 {
        // EINPROGRESS 是正常路径（非阻塞连接进行中）；其它错误才是真失败
        if conn_err != EINPROGRESS {
            return error.TcpConnectFailed;
        }
    }
    if !tcp_wait_writable(fd, timeout_ms) {
        return error.TcpTimeout;
    }
    if tcp_so_error(fd) != 0 {
        return error.TcpConnectFailed;
    }
    // 连上后切回阻塞：SSH 的整包读写按「读到够」的语义写，非阻塞会让上层到处都是 EAGAIN
    if !tcp_set_blocking(fd) {
        return error.TcpSocketFailed;
    }
    ok = true;
    return fd;
}

/// 阻塞读满 n 字节（除非对端关闭）。
/// 参数：fd 为描述符，buf 为目标，n 为期望字节数。
/// 返回值：实际读到的字节数（0 表示对端关闭）。
export fn tcp_read_full(fd: i32, buf: &byte, n: usize) !usize {
    var total: usize = 0;
    while total < n {
        // 不在 catch 里 return：那会直接从本函数返回，语义正确但极易与「给表达式赋值」
        // 混淆（见 tcp_connect_ip 里的说明）。这里显式拆成「取值 + 判错」。
        var got: isize = 0;
        var eid: i32 = 0;
        const gr: !isize = sys_read(fd, buf + total, n - total);
        got = gr catch |err| {
            eid = (@error_id(err) as! i32).value;
            -1 as isize;
        };
        if got < 0 {
            if eid == EINTR {
                return total;
            }
            return error.TcpIoFailed;
        }
        if got == 0 {
            return total;
        }
        total = total + (got as usize);
    }
    return total;
}

/// 阻塞写满 n 字节。
/// 参数：fd 为描述符，buf 为源，n 为字节数。
/// 返回值：实际写出的字节数。
export fn tcp_write_full(fd: i32, buf: &const byte, n: usize) !usize {
    var total: usize = 0;
    while total < n {
        var put: isize = 0;
        var eid: i32 = 0;
        const wr: !isize = sys_write(fd, buf + total, n - total);
        put = wr catch |err| {
            eid = (@error_id(err) as! i32).value;
            -1 as isize;
        };
        if put <= 0 {
            if eid == EINTR {
                return total;
            }
            return error.TcpIoFailed;
        }
        total = total + (put as usize);
    }
    return total;
}

/// 带超时地读一段（返回 0 表示超时无数据）。
/// 参数：fd 为描述符，buf 为目标，n 为上限，timeout_ms 为超时。
/// 返回值：读到的字节数。
export fn tcp_read_timeout(fd: i32, buf: &byte, n: usize, timeout_ms: i32) !usize {
    if !tcp_wait_readable(fd, timeout_ms) {
        return 0 as usize;
    }
    const got: isize = sys_read(fd, buf, n) catch { return error.TcpIoFailed; };
    if got < 0 {
        return 0 as usize;
    }
    return got as usize;
}

/// 关闭连接。
/// 参数：fd 为描述符。
/// 返回值：无。
export fn tcp_close(fd: i32) void {
    _ = sys_close(fd) catch { 0 as i32; };
}
