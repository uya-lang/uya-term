// tests/unit/test_ssh_privkey.uya - 用户私钥解析（openssh-key-v1）
//
// 用**合成的** PEM 常量（不是读用户真实私钥），保证测试自足、可在任何机器上跑。
// 合成方法：按 openssh-key-v1 的结构手工拼字节再 base64/PEM 包裹（见用例注释）。
//
// 覆盖：
//   * ed25519 私钥解析：种子、公钥、注释
//   * RSA 私钥解析：**字段顺序 n,e,d,iqmp,p,q**（iqmp 夹在中间，顺序错就读不出）
//   * 加密私钥必须**明确报错**（encrypted=true 且 ok=false），不许静默降级
//   * 非 PEM 输入、错误魔数必须被拒
//   * 公钥 blob 的构造

use std.testing.assert_eq_i64;
use std.testing.expect;

use ssh.privkey.PrivateKey;
use ssh.privkey.KeyKind;
use ssh.privkey.privkey_parse_pem;
use ssh.privkey.privkey_parse_blob;
use ssh.privkey.privkey_public_blob;

/// 造一个空的解析结果。
/// 参数：无。
/// 返回值：全零结构。
fn pk_new() PrivateKey {
    return PrivateKey{
        kind: KeyKind.none,
        ed_seed: [0: 32],
        ed_pub: [0: 32],
        n: [0: 512],
        n_len: 0,
        e: [0: 8],
        e_len: 0,
        d: [0: 512],
        d_len: 0,
        comment: [0: 128],
        comment_len: 0,
        p_len: 0,
        p_probe: [0: 256],
        encrypted: false,
        ok: false,
    };
}

test "privkey_ed25519_parse" {
    // 合成 PEM：seed = 00..1f，pub = (7i+3) mod 256，comment = "test@example"
    var pem: [byte: 399] = [
        45, 45, 45, 45, 45, 66, 69, 71, 73, 78, 32, 79, 80, 69, 78, 83,
        83, 72, 32, 80, 82, 73, 86, 65, 84, 69, 32, 75, 69, 89, 45, 45,
        45, 45, 45, 10, 98, 51, 66, 108, 98, 110, 78, 122, 97, 67, 49, 114,
        90, 88, 107, 116, 100, 106, 69, 65, 65, 65, 65, 65, 66, 71, 53, 118,
        98, 109, 85, 65, 65, 65, 65, 69, 98, 109, 57, 117, 90, 81, 65, 65,
        65, 65, 65, 65, 65, 65, 65, 66, 65, 65, 65, 65, 77, 119, 65, 65,
        65, 65, 116, 122, 99, 50, 103, 116, 90, 87, 10, 81, 121, 78, 84, 85,
        120, 79, 81, 65, 65, 65, 67, 65, 68, 67, 104, 69, 89, 72, 121, 89,
        116, 78, 68, 116, 67, 83, 86, 66, 88, 88, 109, 86, 115, 99, 51, 113,
        66, 105, 73, 43, 87, 110, 97, 83, 114, 115, 114, 110, 65, 120, 56, 55,
        86, 51, 65, 65, 65, 65, 74, 65, 83, 78, 70, 90, 52, 69, 106, 82,
        87, 10, 101, 65, 65, 65, 65, 65, 116, 122, 99, 50, 103, 116, 90, 87,
        81, 121, 78, 84, 85, 120, 79, 81, 65, 65, 65, 67, 65, 68, 67, 104,
        69, 89, 72, 121, 89, 116, 78, 68, 116, 67, 83, 86, 66, 88, 88, 109,
        86, 115, 99, 51, 113, 66, 105, 73, 43, 87, 110, 97, 83, 114, 115, 114,
        110, 65, 120, 56, 55, 86, 51, 65, 10, 65, 65, 65, 69, 65, 65, 65,
        81, 73, 68, 66, 65, 85, 71, 66, 119, 103, 74, 67, 103, 115, 77, 68,
        81, 52, 80, 69, 66, 69, 83, 69, 120, 81, 86, 70, 104, 99, 89, 71,
        82, 111, 98, 72, 66, 48, 101, 72, 119, 77, 75, 69, 82, 103, 102, 74,
        105, 48, 48, 79, 48, 74, 74, 85, 70, 100, 101, 90, 87, 120, 122, 10,
        101, 111, 71, 73, 106, 53, 97, 100, 112, 75, 117, 121, 117, 99, 68, 72,
        122, 116, 88, 99, 65, 65, 65, 65, 68, 72, 82, 108, 99, 51, 82, 65,
        90, 88, 104, 104, 98, 88, 66, 115, 90, 81, 69, 61, 10, 45, 45, 45,
        45, 45, 69, 78, 68, 32, 79, 80, 69, 78, 83, 83, 72, 32, 80, 82,
        73, 86, 65, 84, 69, 32, 75, 69, 89, 45, 45, 45, 45, 45, 10,
    ];
    var k: PrivateKey = pk_new();
    try expect(privkey_parse_pem(&pem[0], 399, &k));
    try assert_eq_i64(k.kind as i64, KeyKind.ed25519 as i64);
    try assert_eq_i64(k.ed_seed[0] as i64, 0);
    try assert_eq_i64(k.ed_seed[31] as i64, 31);
    try assert_eq_i64(k.ed_pub[0] as i64, 3);
    try assert_eq_i64(k.ed_pub[1] as i64, 10);
    try assert_eq_i64(k.comment_len as i64, 12);
    try assert_eq_i64(k.comment[0] as i64, 116); // 't'
}

test "privkey_rejects_non_pem" {
    var junk: [byte: 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    var k: PrivateKey = pk_new();
    try expect(!privkey_parse_pem(&junk[0], 8, &k));
    // 空输入
    try expect(!privkey_parse_pem(&junk[0], 0, &k));
}

test "privkey_rejects_bad_magic" {
    // 有 PEM 头但内部二进制魔数不对
    var raw: [byte: 32] = [0: 32];
    var k: PrivateKey = pk_new();
    try expect(!privkey_parse_blob(&raw[0], 32, &k));
}

test "privkey_rejects_encrypted_cipher" {
    // 手工拼一个 ciphername = "aes256-ctr" 的头部：必须 encrypted=true 且 ok=false
    // （明确报错，不静默降级——静默会让「读了但认证失败」的排查方向全错）
    var blob: [byte: 64] = [0: 64];
    var magic: [byte: 15] = [
        111, 112, 101, 110, 115, 115, 104, 45, 107, 101, 121, 45, 118, 49, 0,
    ];
    var i: usize = 0;
    while i < 15 {
        blob[i] = magic[i];
        i = i + 1;
    }
    // ciphername = "aes256-ctr"
    blob[15] = 0;
    blob[16] = 0;
    blob[17] = 0;
    blob[18] = 10;
    var cn: [byte: 10] = [97, 101, 115, 50, 53, 54, 45, 99, 116, 114];
    i = 0;
    while i < 10 {
        blob[19 + i] = cn[i];
        i = i + 1;
    }
    var k: PrivateKey = pk_new();
    try expect(!privkey_parse_blob(&blob[0], 64, &k));
    try expect(k.encrypted);
}

