        90, 88, 107, 116, 100, 106, 69, 65, 65, 65, 65, 65, 66, 71, 53, 118,
        98, 109, 85, 65, 65, 65, 65, 69, 98, 109, 57, 117, 90, 81, 65, 65,
        65, 65, 65, 65, 65, 65, 65, 66, 65, 65, 65, 65, 77, 119, 65, 65,
        65, 65, 116, 122, 99, 50, 103, 116, 90, 87, 10, 81, 121, 78, 84, 85,
        120, 79, 81, 65, 65, 65, 67, 65, 68, 67, 104, 69, 89, 72, 121, 89,
        116, 78, 68, 116, 67, 83, 86, 66, 88, 88, 109, 86, 115, 99, 51, 113,
        66, 105, 73, 43, 87, 110, 97, 83, 114, 115, 114, 110, 65, 120, 56, 55,
        86, 51, 65, 65, 65, 65, 74, 65, 83, 78, 70, 90, 52, 69, 106, 82,
        87, 10, 101, 65, 65, 65, 65, 65, 116, 122, 99, 50, 103, 116, 90, 87,
        81, 121, 78, 84, 85, 120, 79, 81, 65, 65, 65, 67, 65, 68, 67, 104,
        69, 89, 72, 121, 89, 116, 78, 68, 116, 67, 83, 86, 66, 88, 88, 109,
        86, 115, 99, 51, 113, 66, 105, 73, 43, 87, 110, 97, 83, 114, 115, 114,
        110, 65, 120, 56, 55, 86, 51, 65, 10, 65, 65, 65, 69, 65, 65, 65,
        81, 73, 68, 66, 65, 85, 71, 66, 119, 103, 74, 67, 103, 115, 77, 68,
        81, 52, 80, 69, 66, 69, 83, 69, 120, 81, 86, 70, 104, 99, 89, 71,
        82, 111, 98, 72, 66, 48, 101, 72, 119, 77, 75, 69, 82, 103, 102, 74,
        105, 48, 48, 79, 48, 74, 74, 85, 70, 100, 101, 90, 87, 120, 122, 10,
        101, 111, 71, 73, 106, 53, 97, 100, 112, 75, 117, 121, 117, 99, 68, 72,
        122, 116, 88, 99, 65, 65, 65, 65, 68, 72, 82, 108, 99, 51, 82, 65,
        90, 88, 104, 104, 98, 88, 66, 115, 90, 81, 69, 61, 10, 45, 45, 45,
        45, 45, 69, 78, 68, 32, 79, 80, 69, 78, 83, 83, 72, 32, 80, 82,
        73, 86, 65, 84, 69, 32, 75, 69, 89, 45, 45, 45, 45, 45, 10,
    ];
    var k: PrivateKey = pk_new();
    try expect(privkey_parse_pem(&pem[0], 399, &k));
    var out: [byte: 128] = [0: 128];
    var n: usize = 0;
    try expect(privkey_public_blob(&k, &out[0], 128, &n));
    // string "ssh-ed25519" (11) + string pub (32) = 4+11+4+32 = 51
    try assert_eq_i64(n as i64, 51);
    try assert_eq_i64(out[3] as i64, 11);
    try assert_eq_i64(out[4] as i64, 115); // 's'
    try assert_eq_i64(out[18] as i64, 32);
    try assert_eq_i64(out[19] as i64, 3);  // pub[0]
}

test "privkey_rsa_field_order_n_e_d_iqmp_p_q" {
    // RSA 私钥段的字段顺序是 **n, e, d, iqmp, p, q** —— iqmp 夹在 d 与 p 之间。
    // 按「n,e,d,p,q」去读会把 iqmp 当 p、p 当 q，得到的密钥完全不可用；
    // 而错误路径只表现为「认证失败」，很难反推到字段顺序。这条用例专门钉住顺序。
    //
    // 合成密钥：n/d 各 256 字节，e = 010001，iqmp 128 字节，p/q 各 129 字节（带前导 0x00）。
