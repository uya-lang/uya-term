        45, 45, 69, 78, 68, 32, 79, 80, 69, 78, 83, 83, 72, 32, 80, 82,
        73, 86, 65, 84, 69, 32, 75, 69, 89, 45, 45, 45, 45, 45, 10,
    ];
    var k: PrivateKey = pk_new();
    try expect(privkey_parse_pem(&pem[0], 1823, &k));
    try assert_eq_i64(k.kind as i64, KeyKind.rsa as i64);
    try assert_eq_i64(k.n_len as i64, 256);
    try assert_eq_i64(k.e_len as i64, 3);
    try assert_eq_i64(k.d_len as i64, 256);
    // e 的三个字节必须是 01 00 01（前导零已被剥掉）
    try assert_eq_i64(k.e[0] as i64, 1);
    try assert_eq_i64(k.e[1] as i64, 0);
    try assert_eq_i64(k.e[2] as i64, 1);
    // 注释读在字段之后，能读对说明前面的字段长度都对齐了
    try assert_eq_i64(k.comment_len as i64, 12);
    try assert_eq_i64(k.comment[0] as i64, 114); // 'r'
    // 公钥 blob：string "ssh-rsa" + mpint e + mpint n
    var out: [byte: 1024] = [0: 1024];
    var bn: usize = 0;
    try expect(privkey_public_blob(&k, &out[0], 1024, &bn));
    // string("ssh-rsa")=11 + mpint(e)=4+3=7 + mpint(n)=4+256=260 → 278
    // （e 与 n 的最高位都是 0，无需补 0x00）
    try assert_eq_i64(bn as i64, 278);
}

