// tests/unit/test_clip_store.uya - 剪贴板仓库单元测试
// 说明：在临时目录里做完整的 put/list/get/clear 往返，并覆盖 MIME 魔数嗅探。

use std.testing.assert_eq_i64;
use std.testing.expect;

use clip.store.ClipStore;
use clip.store.ClipEntry;
use clip.store.clip_store_open;
use clip.store.clip_store_close;
use clip.store.clip_put;
use clip.store.clip_list;
use clip.store.clip_get_current;
use clip.store.clip_set_current;
use clip.store.clip_clear_current;
use clip.store.clip_sniff_mime;
use clip.store.clip_mime_eq;
use clip.store.clip_next_id;
use clip.store.clip_store_reset;
use util.buf.cstr_len;
use util.buf.bytes_eq;

const TEST_DIR: &const byte = "/tmp/uyassh_store_test";

/// 嗅探给定的内容前缀。
/// 参数：data/n 为内容，mime/cap 为输出。
/// 返回值：无。
fn sniff(data: &const byte, n: usize, mime: &byte, cap: usize) void {
    clip_sniff_mime(data, n, mime, cap);
}

test "MIME 魔数嗅探" {
    var mime: [byte: 64] = [0: 64];
    var png: [byte: 16] = [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 0, 0, 0, 0];
    sniff(&png[0], 16, &mime[0], 64);
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "image/png"));
    var jpg: [byte: 3] = [255, 216, 255];
    sniff(&jpg[0], 3, &mime[0], 64);
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "image/jpeg"));
    var gif: [byte: 6] = [71, 73, 70, 56, 57, 97];
    sniff(&gif[0], 6, &mime[0], 64);
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "image/gif"));
    var webp: [byte: 12] = [82, 73, 70, 70, 0, 0, 0, 0, 87, 69, 66, 80];
    sniff(&webp[0], 12, &mime[0], 64);
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "image/webp"));
    const txt: &const byte = "hello, world";
    sniff(txt, cstr_len(txt), &mime[0], 64);
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "text/plain"));
    var bin: [byte: 4] = [0, 1, 2, 3];
    sniff(&bin[0], 4, &mime[0], 64);
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "application/octet-stream"));
}

test "put/list/get/clear 往返" {
    var store: ClipStore = ClipStore{};
    var ok: bool = true;
    const opened: !void = clip_store_open(&store, TEST_DIR);
    _ = opened catch { ok = false; };
    try expect(ok);
    if !ok {
        return;
    }
    clip_store_reset(&store);
    const png: &const byte = "\x89PNG\r\n\x1a\nROUNDTRIP-BYTES";
    const n: usize = cstr_len(png);
    var put_ok: bool = true;
    const id: u32 = clip_put(&store, png, n, "a.png" as &const byte) catch {
        put_ok = false;
        0 as u32;
    };
    try expect(put_ok);
    if !put_ok {
        clip_store_close(&store);
        return;
    }
    try assert_eq_i64(id as i64, 1);
    try assert_eq_i64(store.current_id as i64, 1);

    var entries: [ClipEntry: 8] = [ClipEntry{}: 8];
    const count: usize = clip_list(&store, &entries[0], 8);
    try assert_eq_i64(count as i64, 1);
    try assert_eq_i64(entries[0].id as i64, 1);
    try assert_eq_i64(entries[0].size as i64, n as i64);
    try expect(clip_mime_eq(&entries[0].mime[0], cstr_len(&entries[0].mime[0]), "image/png"));

    var buf: [byte: 256] = [0: 256];
    var mime: [byte: 64] = [0: 64];
    var get_ok: bool = true;
    const got: usize = clip_get_current(&store, &buf[0], 256, &mime[0], 64) catch {
        get_ok = false;
        0 as usize;
    };
    try expect(get_ok);
    if !get_ok {
        clip_store_close(&store);
        return;
    }
    try assert_eq_i64(got as i64, n as i64);
    try expect(bytes_eq(&buf[0], got, png, n));
    try expect(clip_mime_eq(&mime[0], cstr_len(&mime[0]), "image/png"));

    const cleared: !void = clip_clear_current(&store);
    _ = cleared catch { };
    try assert_eq_i64(store.current_id as i64, 0);
    clip_store_close(&store);
}

test "多条写入与当前项切换" {
    var store: ClipStore = ClipStore{};
    var ok: bool = true;
    const opened: !void = clip_store_open(&store, TEST_DIR);
    _ = opened catch { ok = false; };
    try expect(ok);
    if !ok {
        return;
    }
    clip_store_reset(&store);
    const a: &const byte = "first-item";
    const b: &const byte = "second-item-longer";
    const id_a: u32 = clip_put(&store, a, cstr_len(a), null) catch { 0 as u32; };
    const id_b: u32 = clip_put(&store, b, cstr_len(b), null) catch { 0 as u32; };
    try assert_eq_i64(id_b as i64, (id_a + 1u32) as i64);
    try assert_eq_i64(clip_next_id(&store) as i64, (id_b + 1u32) as i64);

    const switched: !void = clip_set_current(&store, id_a);
    _ = switched catch { };
    var buf: [byte: 256] = [0: 256];
    const got: usize = clip_get_current(&store, &buf[0], 256, null, 0) catch { 0 as usize; };
    try assert_eq_i64(got as i64, cstr_len(a) as i64);
    try expect(bytes_eq(&buf[0], got, a, cstr_len(a)));
    clip_store_close(&store);
}
