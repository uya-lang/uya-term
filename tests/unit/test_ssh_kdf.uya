// tests/unit/test_ssh_kdf.uya - SSH 密钥派生单元测试（RFC 4253 §7.2）
//
// 向量由独立的 Python 参考实现算出（按 RFC 4253 §7.2 的公式直接写）。
// 覆盖：
//   * X25519 共享秘密 → mpint 编码：去前导零、最高位为 1 时补 0x00、全零编码为空串。
//     这一条最要紧：漏补 0x00 时双方算出的密钥不同，症状是 NEWKEYS 后第一个包 MAC 就错。
//   * A..F 六个方向的派生
//   * need > 哈希长度时的继续扩展（K1||K2…）

use std.testing.assert_eq_i64;
use std.testing.expect;

use ssh.kdf.kdf_derive;
use ssh.kdf.kdf_secret_to_mpint;

/// 断言两段字节相等。
/// 参数：a/b 为待比较数据，n 为长度。
/// 返回值：无。
fn eq(a: &const byte, b: &const byte, n: usize) !void {
    var i: usize = 0;
    while i < n {
        try assert_eq_i64(a[i] as i64, b[i] as i64);
        i = i + 1;
    }
}

test "kdf_secret_to_mpint_strips_leading_zeros" {
    // 首字节为 0 → 作为大端数的前导零，要去掉（输出比输入短）
    var secret: [byte: 32] = [0: 32];
    var i: usize = 0;
    while i < 32 {
        secret[i] = (((i + 1) % (256 as usize)) as! byte).value;
        i = i + 1;
    }
    secret[0] = 0;
    var out: [byte: 40] = [0: 40];
    var n: usize = 0;
    try expect(kdf_secret_to_mpint(&out[0], 40, &n, &secret[0]));
    try assert_eq_i64(n as i64, 31);
    try assert_eq_i64(out[0] as i64, 2);
}

test "kdf_secret_to_mpint_zero_is_empty" {
    var secret: [byte: 32] = [0: 32];
    var out: [byte: 40] = [0: 40];
    var n: usize = 0;
    try expect(kdf_secret_to_mpint(&out[0], 40, &n, &secret[0]));
    // 全零 → 空串（表示整数 0）
    try assert_eq_i64(n as i64, 0);
}

test "kdf_secret_to_mpint_high_bit_gets_padding" {
    // RFC 8731：把 32 字节按**大端**解释。首字节 0x80 的最高位为 1 → 必须补 0x00。
    var secret: [byte: 32] = [0: 32];
    secret[0] = 0x80 as byte;
    var out: [byte: 40] = [0: 40];
    var n: usize = 0;
    try expect(kdf_secret_to_mpint(&out[0], 40, &n, &secret[0]));
    // 首字节 0x80 为体最高位 → 补 0x00；其余 31 个 0x00 是**尾随零**（有意义），保留
    try assert_eq_i64(n as i64, 33);
    try assert_eq_i64(out[0] as i64, 0);
    try assert_eq_i64(out[1] as i64, 0x80);
    try assert_eq_i64(out[32] as i64, 0);
}

test "kdf_secret_to_mpint_keeps_byte_order" {
    // 关键：**不反转字节**。32 字节小端 u 坐标要「按大端解释」，
    // 即字节序列原样保留，只做去零/补零。
    var secret: [byte: 32] = [0: 32];
    secret[0] = 0x01 as byte;
    secret[1] = 0x02 as byte;
    secret[31] = 0x03 as byte;
    var out: [byte: 40] = [0: 40];
    var n: usize = 0;
    try expect(kdf_secret_to_mpint(&out[0], 40, &n, &secret[0]));
    // secret[0]=0x01 非零 → 无前导零可去；首字节最高位为 0 → 无需补零。
    // 于是 32 字节原样保留（中间的 0x00 是数值的一部分，不能删）。
    try assert_eq_i64(n as i64, 32);
    try assert_eq_i64(out[0] as i64, 1);
    try assert_eq_i64(out[1] as i64, 2);
    try assert_eq_i64(out[31] as i64, 3);
}

test "kdf_derive_a_to_f_against_reference" {
    // K 的 mpint 编码（由 Python 算出）：1f1e…0100
    var mp: [byte: 32] = [
        0x1f, 0x1e, 0x1d, 0x1c, 0x1b, 0x1a, 0x19, 0x18,
        0x17, 0x16, 0x15, 0x14, 0x13, 0x12, 0x11, 0x10,
        0x0f, 0x0e, 0x0d, 0x0c, 0x0b, 0x0a, 0x09, 0x08,
        0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00,
    ];
    var h: [byte: 32] = [
        0x01, 0x08, 0x0f, 0x16, 0x1d, 0x24, 0x2b, 0x32,
        0x39, 0x40, 0x47, 0x4e, 0x55, 0x5c, 0x63, 0x6a,
        0x71, 0x78, 0x7f, 0x86, 0x8d, 0x94, 0x9b, 0xa2,
        0xa9, 0xb0, 0xb7, 0xbe, 0xc5, 0xcc, 0xd3, 0xda,
    ];
    var out: [byte: 48] = [0: 48];

    // A = 8efb962d…
    kdf_derive(&out[0], 32, &mp[0], 32, &h[0], 65 as byte, &h[0], 32);
    var want_a: [byte: 32] = [
        0x8e, 0xfb, 0x96, 0x2d, 0x77, 0x40, 0x64, 0x8e,
        0xb8, 0x0e, 0xc1, 0x41, 0x74, 0x96, 0x2a, 0xe6,
        0x3d, 0x1c, 0xa9, 0x54, 0x59, 0xf5, 0xc8, 0x08,
        0xdb, 0x24, 0xf7, 0x5c, 0x7e, 0x15, 0xa4, 0xf3,
    ];
    try eq(&out[0], &want_a[0], 32);

    // B = 5b5acd6f…
    kdf_derive(&out[0], 32, &mp[0], 32, &h[0], 66 as byte, &h[0], 32);
    var want_b: [byte: 32] = [
        0x5b, 0x5a, 0xcd, 0x6f, 0xb6, 0x1c, 0x8f, 0x42,
        0x3d, 0x31, 0xa0, 0x43, 0x0b, 0x85, 0x4a, 0x0f,
        0xaa, 0xff, 0xb7, 0x95, 0xb1, 0x9b, 0x2e, 0xe0,
        0x5e, 0x9b, 0x3d, 0xb3, 0xca, 0xc9, 0x2a, 0xe3,
    ];
    try eq(&out[0], &want_b[0], 32);

    // C = 2df95467…
    kdf_derive(&out[0], 32, &mp[0], 32, &h[0], 67 as byte, &h[0], 32);
    var want_c: [byte: 32] = [
        0x2d, 0xf9, 0x54, 0x67, 0x61, 0xf8, 0x00, 0xd2,
        0xfb, 0xad, 0x07, 0x52, 0x68, 0x14, 0x19, 0x19,
        0xaa, 0xfa, 0x2a, 0x3d, 0x29, 0xa1, 0x00, 0xb6,
        0x64, 0x92, 0x7d, 0xb3, 0xc6, 0x0a, 0x92, 0x41,
    ];
    try eq(&out[0], &want_c[0], 32);

    // D = d2c8e7ea…
    kdf_derive(&out[0], 32, &mp[0], 32, &h[0], 68 as byte, &h[0], 32);
    var want_d: [byte: 32] = [
        0xd2, 0xc8, 0xe7, 0xea, 0x56, 0x95, 0x72, 0xab,
        0x04, 0x20, 0x1f, 0x04, 0xcb, 0x37, 0xad, 0x81,
        0xa1, 0x73, 0xaf, 0xf9, 0xcb, 0x11, 0xee, 0xc2,
        0x3b, 0x6d, 0xc0, 0xd0, 0x9f, 0x3e, 0xfa, 0x24,
    ];
    try eq(&out[0], &want_d[0], 32);

    // E = 18b5a4b2…
    kdf_derive(&out[0], 32, &mp[0], 32, &h[0], 69 as byte, &h[0], 32);
    var want_e: [byte: 32] = [
        0x18, 0xb5, 0xa4, 0xb2, 0x64, 0xa3, 0x01, 0x37,
        0xba, 0xc5, 0xf4, 0x26, 0xb0, 0xf8, 0x54, 0x48,
        0xee, 0x30, 0xaa, 0x6a, 0xaa, 0xc8, 0x77, 0x67,
        0x4c, 0xa1, 0x9d, 0xee, 0x6f, 0x8b, 0xda, 0x4c,
    ];
    try eq(&out[0], &want_e[0], 32);

    // F = d541d4a1…
    kdf_derive(&out[0], 32, &mp[0], 32, &h[0], 70 as byte, &h[0], 32);
    var want_f: [byte: 32] = [
        0xd5, 0x41, 0xd4, 0xa1, 0x59, 0x15, 0x19, 0xc7,
        0x42, 0x87, 0x39, 0x54, 0x4f, 0x32, 0x1b, 0xd3,
        0x26, 0x6c, 0x33, 0x07, 0xa0, 0x97, 0x3c, 0x0e,
        0x13, 0xfd, 0x87, 0x21, 0x9a, 0x50, 0x15, 0xb5,
    ];
    try eq(&out[0], &want_f[0], 32);
}

test "kdf_derive_extends_beyond_hash_length" {
    var mp: [byte: 32] = [
        0x1f, 0x1e, 0x1d, 0x1c, 0x1b, 0x1a, 0x19, 0x18,
        0x17, 0x16, 0x15, 0x14, 0x13, 0x12, 0x11, 0x10,
        0x0f, 0x0e, 0x0d, 0x0c, 0x0b, 0x0a, 0x09, 0x08,
        0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00,
    ];
    var h: [byte: 32] = [
        0x01, 0x08, 0x0f, 0x16, 0x1d, 0x24, 0x2b, 0x32,
        0x39, 0x40, 0x47, 0x4e, 0x55, 0x5c, 0x63, 0x6a,
        0x71, 0x78, 0x7f, 0x86, 0x8d, 0x94, 0x9b, 0xa2,
        0xa9, 0xb0, 0xb7, 0xbe, 0xc5, 0xcc, 0xd3, 0xda,
    ];
    // need=48 → 前 32 字节是 A 段，后 16 字节是扩展段
    var out: [byte: 48] = [0: 48];
    kdf_derive(&out[0], 48, &mp[0], 32, &h[0], 65 as byte, &h[0], 32);
    var want: [byte: 48] = [
        0x8e, 0xfb, 0x96, 0x2d, 0x77, 0x40, 0x64, 0x8e,
        0xb8, 0x0e, 0xc1, 0x41, 0x74, 0x96, 0x2a, 0xe6,
        0x3d, 0x1c, 0xa9, 0x54, 0x59, 0xf5, 0xc8, 0x08,
        0xdb, 0x24, 0xf7, 0x5c, 0x7e, 0x15, 0xa4, 0xf3,
        0x00, 0xa6, 0xda, 0x36, 0x04, 0x47, 0x71, 0x15,
        0xaa, 0x0d, 0xb2, 0x2b, 0x4f, 0x31, 0x3c, 0x26,
    ];
    try eq(&out[0], &want[0], 48);
}
